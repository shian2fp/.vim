vim9script

# override the file name used for viminfo.
set viminfofile=~/.vim/viminfo

# do not make a backup file before overwriting a file.
set nobackup

# evaluate a modeline.
set modeline

# show 4 lines around the cursor.
set scrolloff=4

# show 8 characters around the cursor.
set sidescrolloff=8

# vim: ft=vim ts=4 sw=0 sts=0 et
